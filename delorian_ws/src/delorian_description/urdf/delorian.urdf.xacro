<?xml version="1.0"?>
<robot name="Delorian" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- sim:=true agrega plugins y friccion de Gazebo; el robot real usa sim:=false -->
    <xacro:arg name="sim" default="false"/>

    <xacro:include filename="delorian_core.xacro"/>
    <xacro:if value="$(arg sim)">
        <xacro:include filename="delorian.gazebo.xacro"/>
    </xacro:if>
</robot>
