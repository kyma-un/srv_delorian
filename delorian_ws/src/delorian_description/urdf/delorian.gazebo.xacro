<?xml version="1.0"?>
<!-- Solo simulacion (gz sim). Se incluye desde delorian.urdf.xacro cuando sim:=true. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Friccion de las ruedas. En skid-steer, si al girar vibra o no gira, baja mu2. -->
    <xacro:macro name="wheel_friction" params="name">
        <gazebo reference="${name}">
            <mu1>1.0</mu1>
            <mu2>1.0</mu2>
        </gazebo>
    </xacro:macro>

    <xacro:wheel_friction name="front_left_wheel"/>
    <xacro:wheel_friction name="rear_left_wheel"/>
    <xacro:wheel_friction name="front_right_wheel"/>
    <xacro:wheel_friction name="rear_right_wheel"/>

    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>front_left_wheel_joint</left_joint>
            <left_joint>rear_left_wheel_joint</left_joint>
            <right_joint>front_right_wheel_joint</right_joint>
            <right_joint>rear_right_wheel_joint</right_joint>
            <!-- En skid-steer la separacion efectiva suele ser mayor que la geometrica; ajustar si el giro no cuadra -->
            <wheel_separation>${track}</wheel_separation>
            <wheel_radius>${wheel_r}</wheel_radius>
            <topic>cmd_vel</topic>
            <!-- No se usa /odom porque ese nombre ya lo publica rgbd_odometry -->
            <odom_topic>odometry/wheel</odom_topic>
            <odom_publish_frequency>50</odom_publish_frequency>
            <tf_topic>tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
        </plugin>

        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
        </plugin>
    </gazebo>

    <gazebo reference="oak_link">
        <sensor name="oak" type="rgbd_camera">
            <topic>oak</topic>
            <gz_frame_id>oak_optical_link</gz_frame_id>
            <update_rate>30</update_rate>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <camera>
                <horizontal_fov>1.2</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>400</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.2</near>
                    <far>10</far>
                </clip>
                <depth_camera>
                    <clip>
                        <near>0.2</near>
                        <far>10</far>
                    </clip>
                </depth_camera>
                <noise>
                    <type>gaussian</type>
                    <mean>0</mean>
                    <stddev>0.007</stddev>
                </noise>
            </camera>
        </sensor>
    </gazebo>
</robot>
